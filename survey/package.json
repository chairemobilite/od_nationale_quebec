{
  "engines": {
    "node": ">=24.0.0"
  },
  "name": "od_nationale_quebec",
  "version": "0.5.0",
  "main": "index.js",
  "author": "Chaire Mobilité",
  "private": true,
  "repository": "github.com/chairemobilite/od_qc",
  "scripts": {
    "build:dev": "NODE_OPTIONS=\"--trace-deprecation --max_old_space_size=4096 --openssl-legacy-provider\" webpack --watch --progress --color --node-env development --mode development",
    "build:prod": "NODE_OPTIONS=\"--trace-deprecation --max_old_space_size=1024 --openssl-legacy-provider\" webpack --progress --color --node-env production --mode production",
    "build:admin:dev": "NODE_OPTIONS=\"--trace-deprecation --max_old_space_size=4096 --openssl-legacy-provider\" webpack --config webpack.admin.config.js --watch --progress --color --node-env development --mode development",
    "build:admin:prod": "NODE_OPTIONS=\"--trace-deprecation --max_old_space_size=1024 --openssl-legacy-provider\" webpack --config webpack.admin.config.js --progress --color --node-env production --mode production",
    "clean": "rimraf lib/",
    "cleanModules": "rimraf node_modules/",
    "copy-files": "mkdir -p lib/survey lib/survey/config lib/survey/geojson lib/styles && find src/survey/config -maxdepth 1 -type f -name '*.json' -exec cp {} lib/survey/config ';' && find src/survey/geojson/ -maxdepth 1 -type f -name '*.json' -exec cp {} lib/survey/geojson/ ';'",
    "compile": "tsc && yarn copy-files",
    "compile:dev": "yarn copy-files && tsc -w",
    "start": "yarn node lib/server.js --max-old-space-size=4096",
    "start:admin": "yarn node lib/admin/serverAdmin.js --max-old-space-size=4096",
    "start:admin:debug": "DEBUG=\"express:*\" yarn node --trace-warnings lib/admin/serverAdmin.js --max-old-space-size=4096",
    "start:tracing": "yarn node -r ../tracing.js lib/server.js --max-old-space-size=4096",
    "start:admin:tracing": "yarn node -r ../tracing.js lib/admin/serverAdmin.js --max-old-space-size=4096",
    "start:debug": "DEBUG=\"express:*\" yarn node --trace-warnings lib/server.js --max-old-space-size=4096",
    "test": "NODE_ENV=test jest --config=jest.config.js",
    "format": "prettier --write --log-level warn \"./src/**/*.{ts,tsx}\" && eslint --fix --quiet \"./src/**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "unimported": "npx unimported",
    "test:ui": "LOCALE_DIR=$(pwd)/locales TRANSITION_DOTENV='../.env' npx playwright test",
    "reset:test:ui": "yarn node lib/tasks/removeUiTestParticipants.js"
  },
  "browser": {
    "[module-name]": false
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@turf/turf": "^7.3.5",
    "chaire-lib-backend": "workspace:^",
    "chaire-lib-common": "workspace:^",
    "chaire-lib-frontend": "workspace:^",
    "evolution-backend": "workspace:^",
    "evolution-common": "workspace:^",
    "evolution-frontend": "workspace:^",
    "evolution-interviewer": "workspace:^",
    "i18next": "^26.3.4",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "moment-business-days": "^1.2.0",
    "moment-timezone": "^0.5.46",
    "papaparse": "^5.5.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.6",
    "react-router": "^7.18.2",
    "recharts": "^3.2.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/geojson": "^7946.0.16",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.10.4",
    "eslint": "^10.13.0",
    "eslint-plugin-n": "^18.5.0",
    "express": "^5.2.1",
    "jest": "^30.2.0",
    "jest-each": "^30.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
